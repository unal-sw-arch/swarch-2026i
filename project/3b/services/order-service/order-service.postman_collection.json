                  "if (body.items.length > 0) {",
                  "    const item = body.items[0];",
                  "    pm.test('restaurant summary: tiene id', () => pm.expect(item.id).to.be.a('number'));",
                  "    pm.test('restaurant summary: tiene customerId', () => pm.expect(item.customerId).to.be.a('number'));",
                  "    pm.test('restaurant summary: tiene status', () => pm.expect(item.status).to.be.a('string'));",
                  "    pm.test('restaurant summary: tiene totalAmount', () => pm.expect(item.totalAmount).to.be.a('number'));",
                  "    // NO debe tener restaurantId (es la vista del restaurante, ya implícito)",
