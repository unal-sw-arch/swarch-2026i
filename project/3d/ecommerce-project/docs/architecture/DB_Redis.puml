@startuml DB_Redis
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam backgroundColor #FAFAFA
skinparam map {
    BackgroundColor #FFFFFF
    BorderColor #DC382D
    FontColor #1a1a1a
    HeaderBackgroundColor #DC382D
    HeaderFontColor #FFFFFF
    HeaderFontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F0C040
    FontColor #333333
    FontSize 10
}
skinparam arrow {
    Color #DC382D
    FontColor #333333
    FontSize 10
}

title <b>Redis Cloud — Estructuras Clave-Valor (NoSQL)</b>\nE-commerce — Grupo D

' ── SESIONES JWT ────────────────────────────────────────
map "session:{user_id}  · STRING" as session {
    valor => JWT access token (string)
    TTL => 3600 s (1 hora)
    escrito_por => core-service · POST /auth/login
    leido_por => core-service · middleware JWT
    operacion => SET ... EX 3600
}

' ── CARRITO DE COMPRAS ──────────────────────────────────
map "cart:{user_id}  · HASH" as cart {
    campo => valor
    {product_id}:qty => cantidad (integer)
    {product_id}:price => precio unitario (string)
    TTL => 86400 s (24 horas)
    escrito_por => core-service · /cart endpoints
    operacion => HSET / HGETALL / HDEL
}

' ── CACHÉ DE BÚSQUEDA SEMÁNTICA ─────────────────────────
map "search:v1:{sha256(query)}  · STRING" as search_cache {
    valor => JSON array de productos (string)
    TTL => 300 s (5 minutos)
    escrito_por => ai-service · búsqueda semántica
    leido_por => ai-service · cache-aside
    operacion => GET / SET ... EX 300
}

' ── CACHÉ DE RECOMENDACIONES ────────────────────────────
map "rec:v1:{user_id}:{category_id}  · STRING" as rec_cache {
    valor => JSON array de product_ids (string)
    TTL => 600 s (10 minutos)
    escrito_por => ai-service · respuesta Gemini
    leido_por => ai-service · cache-aside
    operacion => GET / SET ... EX 600
}

' ── RATE LIMITING ───────────────────────────────────────
map "rate:{endpoint}:{ip}  · COUNTER" as rate_limit {
    valor => contador de requests (integer)
    TTL => 60 s (ventana deslizante)
    gestionado_por => core-service y ai-service
    limite => 60 req/min por IP
    operacion => INCR / EXPIRE
}

' ── NOTAS DE INVALIDACIÓN ───────────────────────────────
note bottom of cart
  Al confirmar checkout (POST /orders):
  core-service ejecuta DEL cart:{user_id}
  → carrito limpio post-compra
end note

note bottom of rec_cache
  Al completar una compra o publicar reseña:
  core-service invalida rec:v1:{user_id}:*
  → recomendaciones frescas de Gemini
end note

@enduml
