                  "    pm.test('customer summary: tiene status', () => pm.expect(item.status).to.be.a('string'));",
                  "    pm.test('customer summary: tiene totalAmount', () => pm.expect(item.totalAmount).to.be.a('number'));",
                  "    // NO debe tener customerId (es la vista del customer, no del restaurante)",
                  "    pm.test('customer summary: NO tiene customerId', () => pm.expect(item.customerId).to.be.undefined);",
                  "    pm.test('customer summary: NO tiene items de detalle', () => pm.expect(item.items).to.be.undefined);",
                  "}"
                ]
