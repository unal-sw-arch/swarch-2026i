# ============================================================
# AICart — Variables de entorno
# Fuente de verdad de defaults: docker-compose.yml
# Copia este archivo a .env y ajusta los valores marcados como OBLIGATORIO.
# ============================================================

# --- Auth PostgreSQL (OBLIGATORIO — sin default en compose) ---
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth_password
AUTH_POSTGRES_DB=auth_db

# --- User PostgreSQL (OBLIGATORIO) ---
USER_POSTGRES_USER=user_user
USER_POSTGRES_PASSWORD=user_password
USER_POSTGRES_DB=user_db

# --- Product PostgreSQL (OBLIGATORIO) ---
PRODUCT_POSTGRES_USER=product_user
PRODUCT_POSTGRES_PASSWORD=product_password
PRODUCT_POSTGRES_DB=product_db

# --- Order PostgreSQL (OBLIGATORIO) ---
ORDER_POSTGRES_USER=order_user
ORDER_POSTGRES_PASSWORD=order_password
ORDER_POSTGRES_DB=order_db

# --- AI PostgreSQL (pgvector — índice RAG del asistente) ---
AI_POSTGRES_USER=ai_user
AI_POSTGRES_PASSWORD=ai_password
AI_POSTGRES_DB=ai_db

# --- Connection strings (OBLIGATORIO — deben coincidir con las credenciales de arriba) ---
AUTH_DATABASE_URL=postgresql+asyncpg://auth_user:auth_password@auth-postgres:5432/auth_db
USER_DATABASE_URL=postgresql+psycopg2://user_user:user_password@user-postgres:5432/user_db
PRODUCT_DATABASE_URL=postgresql+asyncpg://product_user:product_password@product-postgres:5432/product_db
ORDER_DATABASE_URL=postgresql+asyncpg://order_user:order_password@order-postgres:5432/order_db
AI_DATABASE_URL=postgresql+asyncpg://ai_user:ai_password@ai-postgres:5432/ai_db

# --- Auth-service ---
AUTH_APP_NAME=Auth Service
AUTH_DEBUG=false
# OBLIGATORIO: mínimo 32 caracteres. Compartido por auth, product y order para validar JWT.
AUTH_JWT_SECRET=replace_with_a_secure_secret_min_32_chars
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRE_MINUTES=60

# --- Redis ---
REDIS_URL=redis://redis:6379/0
AI_REDIS_URL=redis://redis:6379/1

# --- RabbitMQ ---
RABBITMQ_ERLANG_COOKIE=ecommerce_local_cookie
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
USER_PROFILE_QUEUE_NAME=user_profile_create_queue

# --- Order-service ---
ORDER_APP_NAME=Order Service
ORDER_APP_VERSION=1.0.0
ORDER_EVENTS_EXCHANGE=events
PRODUCT_SERVICE_URL=http://product-service:8003
PRODUCT_SERVICE_TIMEOUT_SECONDS=10

# --- Product-service ---
PRODUCT_APP_NAME=Product Service
PRODUCT_DEBUG=false
USER_SERVICE_BASE_URL=http://user-service:8000

# --- AI-service (Groq) ---
AI_APP_NAME=AI Service
AI_APP_VERSION=1.0.0
AI_DEBUG=false
AI_API_V1_PREFIX=/api/v1
# Necesaria para el asistente de IA — obtenla en https://console.groq.com/
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_ALLOWED_ORIGINS=http://localhost:3000
AI_REQUEST_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
USER_SERVICE_URL=http://user-service:8000
ORDER_SERVICE_URL=http://order-service:8004
JWT_ALGORITHM=HS256
# RAG / pgvector (embeddings locales con fastembed)
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_INDEX_REFRESH_SECONDS=300
AI_RAG_TOP_K=8
AI_PROFILE_WEIGHT=0.25

# --- API Gateway + Frontend ---
API_GATEWAY_HTTP_PORT=8000
API_GATEWAY_HTTPS_PORT=8443
FRONTEND_EXTERNAL_PORT=3000
# URL pública del gateway que usa el browser (CSR). El SSR usa http://api-gateway:8000 interno.
NEXT_PUBLIC_API_URL=https://localhost:8443

# --- Proxies corporativos para builds Docker (dejar vacío si no aplica) ---
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,api-gateway,auth-service,user-service,product-service,order-service,ai-service,auth-postgres,user-postgres,order-postgres,ai-postgres,rabbitmq
