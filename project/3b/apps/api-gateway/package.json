{
  "name": "api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "API Gateway en Node.js + TypeScript + Express",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "test:waf": "tsx test/waf.rules.spec.ts"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "redis": "^5.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
