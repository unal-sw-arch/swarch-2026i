# Auth PostgreSQL (dedicated DB for auth-service)
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth_password
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_HOST=auth-postgres
AUTH_POSTGRES_PORT=5432
AUTH_POSTGRES_EXTERNAL_PORT=5433

# User PostgreSQL (dedicated DB for user-service)
USER_POSTGRES_USER=user_user
USER_POSTGRES_PASSWORD=user_password
USER_POSTGRES_DB=user_db
USER_POSTGRES_HOST=user-postgres
USER_POSTGRES_PORT=5432
USER_POSTGRES_EXTERNAL_PORT=5432

# Order PostgreSQL (dedicated DB for order-service)
ORDER_POSTGRES_USER=order_user
ORDER_POSTGRES_PASSWORD=order_password
ORDER_POSTGRES_DB=order_db
ORDER_POSTGRES_HOST=order-postgres
ORDER_POSTGRES_PORT=5432
ORDER_POSTGRES_EXTERNAL_PORT=5434

# Auth-service settings
AUTH_DATABASE_URL=postgresql+asyncpg://auth_user:auth_password@auth-postgres:5432/auth_db
AUTH_APP_NAME=Auth Service
AUTH_DEBUG=false
AUTH_JWT_SECRET=replace_with_a_secure_secret_min_32_chars
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRE_MINUTES=60
AUTH_SERVICE_EXTERNAL_PORT=8001

# User-service settings
USER_DATABASE_URL=postgresql+psycopg2://user_user:user_password@user-postgres:5432/user_db
USER_SERVICE_EXTERNAL_PORT=8002

# Product-service settings
PRODUCT_DATABASE_URL=postgresql+asyncpg://user_user:user_password@user-postgres:5432/user_db
PRODUCT_APP_NAME=Product Service
PRODUCT_DEBUG=false
PRODUCT_SERVICE_EXTERNAL_PORT=8003

# Order-service settings
ORDER_DATABASE_URL=postgresql+asyncpg://order_user:order_password@order-postgres:5432/order_db
ORDER_APP_NAME=Order Service
ORDER_APP_VERSION=1.0.0
ORDER_SERVICE_EXTERNAL_PORT=8004
ORDER_EVENTS_EXCHANGE=events
PRODUCT_SERVICE_URL=http://product-service:8003
PRODUCT_SERVICE_TIMEOUT_SECONDS=10

# AI-service settings
AI_APP_NAME=AI Service
AI_APP_VERSION=1.0.0
AI_DEBUG=false
AI_API_V1_PREFIX=/api/v1
AI_SERVICE_EXTERNAL_PORT=8005
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_ALLOWED_ORIGINS=http://localhost:3000
AI_REQUEST_TIMEOUT_SECONDS=30

# API Gateway + Frontend
API_GATEWAY_EXTERNAL_PORT=8000
FRONTEND_EXTERNAL_PORT=3000
VITE_API_URL=http://localhost:8000

# Optional proxy values for Docker build environments behind corporate networks
# Leave empty if not needed.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,api-gateway,auth-service,user-service,product-service,order-service,ai-service,auth-postgres,user-postgres,order-postgres,rabbitmq

# Internal service-to-service
USER_SERVICE_INTERNAL_URL=http://user-service:8000
USER_SERVICE_TIMEOUT_SECONDS=10
RABBITMQ_HOST=rabbitmq
USER_PROFILE_QUEUE_NAME=user_profile_create_queue

# PostgreSQL access from host machine:
# Auth DB: localhost:${AUTH_POSTGRES_EXTERNAL_PORT} user=${AUTH_POSTGRES_USER} db=${AUTH_POSTGRES_DB}
# User DB: localhost:${USER_POSTGRES_EXTERNAL_PORT} user=${USER_POSTGRES_USER} db=${USER_POSTGRES_DB}
