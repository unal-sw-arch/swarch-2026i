# ============================================================
# Variables de entorno requeridas para order-service
# Copiar como .env y completar con valores reales
# NUNCA commitear el .env con credenciales reales
# ============================================================

# Servidor
SERVER_PORT=8080

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_USERNAME=<usuario>
DB_PASSWORD=<contraseña>

# JPA
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false

# Inicialización SQL (always = ejecuta schema.sql + data.sql al arrancar)
SQL_INIT_MODE=never

# Integración externa
TRACKING_SERVICE_URL=http://<host>:<port>

# Logging
LOG_LEVEL=INFO
