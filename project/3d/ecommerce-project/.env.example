# PostgreSQL
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_postgres_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Backend app settings
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@postgres:5432/your_postgres_db
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace_with_a_secure_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
GEMINI_API_KEY=
APP_NAME=E-commerce API
DEBUG=false

# Frontend
VITE_API_URL=http://localhost:8000
