EXPO_PUBLIC_STAGE=dev

# Legacy auth/restaurants flow (productsApi)
# Secure Channel: the gateway is TLS-only, so use https:// (and wss:// below).
EXPO_PUBLIC_API_URL=https://192.168.1.8:8080
EXPO_PUBLIC_API_URL_IOS=https://localhost:8080
EXPO_PUBLIC_API_URL_ANDROID=https://10.0.2.2:8080

# API Gateway (REST – waiter/orders/menus go through the gateway)
EXPO_PUBLIC_GATEWAY_URL=https://192.168.1.8:8080
EXPO_PUBLIC_GATEWAY_URL_IOS=https://localhost:8080
EXPO_PUBLIC_GATEWAY_URL_ANDROID=https://10.0.2.2:8080

# STOMP/WebSocket (realtime kitchen events, proxied by the gateway on 8080)
EXPO_PUBLIC_ORDER_WS_URL=wss://192.168.1.8:8080/ws/kitchen
EXPO_PUBLIC_ORDER_WS_URL_IOS=wss://localhost:8080/ws/kitchen
EXPO_PUBLIC_ORDER_WS_URL_ANDROID=wss://10.0.2.2:8080/ws/kitchen

# Hardcoded fallback until the waiter's restaurant can be inferred from the JWT
EXPO_PUBLIC_WAITER_RESTAURANT_ID=1
