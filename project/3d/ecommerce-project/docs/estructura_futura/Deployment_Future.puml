@startuml
!theme plain
skinparam shadowing false
left to right direction

title Deployment View - Future Ideal Structure

node "Cloud Provider" {
  node "Edge" {
    node "CDN + WAF" as Edge
    node "Ingress Gateway" as Ingress
  }

  node "Kubernetes Cluster" {
    node "frontend-web pod" as Frontend
    node "auth-service pods" as Auth
    node "user-service pods" as User
    node "product-service pods" as Product
    node "inventory-service pods" as Inventory
    node "cart-service pods" as Cart
    node "order-service pods" as Order
    node "payment-service pods" as Payment
    node "ai-assistant-service pods" as AI
    node "recommendation-service workers" as Reco
    node "notification-service workers" as Notify
  }

  node "Managed Data Layer" {
    database "auth-postgres" as AuthDB
    database "user-postgres" as UserDB
    database "product-postgres" as ProductDB
    database "inventory-postgres" as InventoryDB
    database "order-postgres" as OrderDB
    database "payment-postgres" as PaymentDB
    database "redis cluster" as Redis
    queue "rabbitmq cluster" as MQ
    database "vector store" as VectorDB
    database "object storage" as Blob
  }

  node "Observability" {
    component "OpenTelemetry Collector" as Otel
    component "Prometheus" as Prom
    component "Grafana" as Grafana
    component "Centralized Logs" as Logs
  }

  node "External Providers" {
    component "Wompi/PSE/Nequi" as Provider
    component "Email/SMS/Push" as Comms
    component "LLM Provider" as LLM
  }
}

Edge --> Ingress
Ingress --> Frontend
Ingress --> Auth
Ingress --> User
Ingress --> Product
Ingress --> Cart
Ingress --> Order
Ingress --> Payment
Ingress --> AI

Auth --> AuthDB
User --> UserDB
Product --> ProductDB
Inventory --> InventoryDB
Order --> OrderDB
Payment --> PaymentDB
Cart --> Redis
Auth --> Redis
Product --> Blob
AI --> VectorDB
Reco --> VectorDB

Auth --> MQ
Product --> MQ
Order --> MQ
Payment --> MQ
Notify --> MQ
Reco --> MQ

Payment --> Provider
Notify --> Comms
AI --> LLM

Auth --> Otel
User --> Otel
Product --> Otel
Inventory --> Otel
Cart --> Otel
Order --> Otel
Payment --> Otel
AI --> Otel
Reco --> Otel
Notify --> Otel

Otel --> Prom
Otel --> Logs
Prom --> Grafana

@enduml
