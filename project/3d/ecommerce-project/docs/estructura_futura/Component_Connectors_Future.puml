@startuml
!theme plain
skinparam componentStyle rectangle
skinparam shadowing false
left to right direction

title Component and Connector View - Future Ideal Structure

actor "Web User" as WebUser
actor "Mobile User" as MobileUser
component "Web Frontend\n(Next.js + BFF)" as Web
component "Mobile App\n(React Native/Flutter)" as Mobile
component "API Gateway\n(Edge + Rate Limit)" as Gateway

component "Auth Service\n(FastAPI)" as Auth
component "User Service\n(FastAPI)" as User
component "Product Service\n(FastAPI)" as Product
component "Inventory Service\n(FastAPI)" as Inventory
component "Order Service\n(FastAPI)" as Order
component "Payment Service\n(FastAPI)" as Payment
component "Recommendation Service\n(FastAPI)" as Reco
component "AI Assistant Service\n(FastAPI + LLM)" as AI

database "Auth DB\n(PostgreSQL)" as AuthDB
database "User DB\n(PostgreSQL)" as UserDB
database "Product DB\n(PostgreSQL)" as ProductDB
database "Order DB\n(PostgreSQL)" as OrderDB
database "Payment DB\n(PostgreSQL)" as PaymentDB
database "Redis\n(session + cache + cart)" as Redis
database "Vector Store\n(pgvector or dedicated DB)" as VectorDB
queue "RabbitMQ\n(Event Bus)" as MQ

WebUser --> Web : HTTPS
MobileUser --> Mobile : HTTPS
Web --> Gateway : REST/JSON
Mobile --> Gateway : REST/JSON

Gateway --> Auth : /auth/*
Gateway --> User : /users/*
Gateway --> Product : /products/*
Gateway --> Cart : /cart/*
Gateway --> Order : /orders/*
Gateway --> Payment : /payments/*
Gateway --> AI : /ai/*
Gateway --> Reco : /recommendations/*

Auth --> AuthDB
User --> UserDB
Product --> ProductDB
Product --> ObjectStore
Inventory --> ProductDB : stock projections
Cart --> Redis : cart sessions
Order --> OrderDB
Payment --> PaymentDB
Auth --> Redis : JWT session + blacklist
Reco --> VectorDB
AI --> VectorDB

Order --> Inventory : reserve/release stock
Order --> Payment : create payment intent
Payment --> Provider : payment transactions

Auth --> MQ : AUTH_USER_REGISTERED
Product --> MQ : PRODUCT_CREATED/UPDATED
Order --> MQ : ORDER_CREATED/CANCELLED/SHIPPED
Payment --> MQ : PAYMENT_CONFIRMED/FAILED
Reco --> MQ : consume behavior events
AI --> MQ : optional moderation/review events

@enduml
