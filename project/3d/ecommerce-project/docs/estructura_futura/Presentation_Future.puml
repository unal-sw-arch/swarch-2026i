@startuml
!theme plain
skinparam componentStyle rectangle
skinparam shadowing false
left to right direction

title Presentation View - Future Ideal UX Architecture

actor "Authenticated User" as User
actor "Guest User" as Guest

package "frontend/web (Next.js App Router)" {
  component "public routes\n(login/register/landing)" as PublicRoutes
  component "shop routes\n(catalog/detail/cart/checkout)" as ShopRoutes
  component "account routes\n(orders/profile/seller)" as AccountRoutes
  component "assistant routes\n(chat + recommendations)" as AssistantRoutes
  component "BFF handlers\n(app/api/*)" as BFF
  component "state layer\n(auth + cart + query cache)" as State
  component "shared UI system\n(tokens + components)" as UI

  PublicRoutes --> State
  ShopRoutes --> State
  AccountRoutes --> State
  AssistantRoutes --> State

  PublicRoutes --> UI
  ShopRoutes --> UI
  AccountRoutes --> UI
  AssistantRoutes --> UI

  ShopRoutes --> BFF
  AccountRoutes --> BFF
  AssistantRoutes --> BFF
}

component "API Gateway" as Gateway
component "Auth Service" as Auth
component "User Service" as UserSvc
component "Product Service" as Product
component "Cart Service" as Cart
component "Order Service" as Order
component "Payment Service" as Payment
component "AI Assistant Service" as AI
component "Recommendation Service" as Reco

Guest --> PublicRoutes
User --> ShopRoutes
User --> AccountRoutes
User --> AssistantRoutes

BFF --> Gateway : internal REST
Gateway --> Auth
Gateway --> UserSvc
Gateway --> Product
Gateway --> Cart
Gateway --> Order
Gateway --> Payment
Gateway --> AI
Gateway --> Reco

@enduml
