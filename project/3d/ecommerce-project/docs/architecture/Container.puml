@startuml C4_L2_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_TOP_DOWN()
SHOW_PERSON_OUTLINE()

title Container Diagram — E-commerce Platform (Grupo D)

' ── Actors ───────────────────────────────────────────────────────────
Person(customer, "Customer", "End buyer")
Person(admin, "Admin", "Store manager")

' ── Platform Boundary ────────────────────────────────────────────────
System_Boundary(platform, "E-commerce Platform") {
    Container(frontend, "Next.js Frontend", "TypeScript / Next.js 14 App Router", "Web UI: product catalog, cart, checkout, orders, admin panel and AI chatbot widget. Acts as BFF.")
    Container(core, "core-service", "Python 3.12 / FastAPI / SQLAlchemy 2.0", "Auth, product catalog, cart, orders, payments and reviews. Core business logic.")
    Container(ai, "ai-service", "Python 3.12 / FastAPI / google-generativeai", "AI assistant (Gemini), personalized recommendations, semantic search and review moderation.")
    ContainerDb(db, "PostgreSQL + pgvector", "Supabase PostgreSQL 15", "Users, products, orders, reviews, payments and product embedding vectors.")
    ContainerDb(cache, "Redis Cache", "Redis Cloud — NoSQL key-value", "JWT sessions, cart state, search TTL cache and rate limiting.")
}

' ── External Systems ─────────────────────────────────────────────────
System_Ext(gemini, "Google Gemini Flash API", "LLM + text-embedding-004")
System_Ext(wompi, "Wompi Colombia", "PSE · Nequi · Cards")

' ── Relations ────────────────────────────────────────────────────────
Rel_D(customer, frontend, "Browses, manages cart, checks out", "HTTPS")
Rel_D(admin, frontend, "Manages products and orders", "HTTPS")

Rel_D(frontend, core, "Auth, products, orders, cart, payments, reviews", "① REST JSON/HTTPS")
Rel_D(frontend, ai, "AI chat, semantic search, recommendations", "① REST JSON/HTTPS")

Rel_R(core, ai, "Fraud detection, review moderation", "② Internal REST httpx async")

Rel_D(core, db, "Reads/writes business data", "PostgreSQL (TLS)")
Rel_D(ai, db, "Reads product vectors, writes embeddings", "PostgreSQL (TLS)")

Rel_D(core, cache, "Sessions, cart, rate limits", "Redis (TLS)")
Rel_D(ai, cache, "Caches Gemini responses (TTL)", "Redis (TLS)")

Rel_R(core, wompi, "Payments + HMAC-SHA256 webhooks", "HTTPS / REST")
Rel_R(ai, gemini, "Chat, embeddings, moderation", "HTTPS / Gemini SDK")

SHOW_LEGEND()
@enduml
