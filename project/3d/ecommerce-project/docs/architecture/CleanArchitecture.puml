@startuml CleanArchitecture
!theme plain
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

title Clean Architecture — E-commerce Platform (per microservice)

' ── PRESENTATION LAYER ────────────────────────────────────────────────
package "Presentation Layer" <<Rectangle>> #D6EAF8 {
    component [FastAPI Routers\n────────────────\nPOST /auth/register\nPOST /auth/login\nGET  /products\nPOST /orders/checkout\nPOST /payments/webhook\nPOST /chat\nGET  /search] as PRESENTATION
    component [Pydantic v2 Schemas\n────────────────\nRequest DTOs\nResponse DTOs\n(Input validation)] as SCHEMAS
}

' ── APPLICATION LAYER ─────────────────────────────────────────────────
package "Application Layer" <<Rectangle>> #D5F5E3 {
    component [Use Cases / Services\n────────────────\nAuthService\nProductService\nOrderService\nPaymentService\nReviewService\nChatService\nSemanticSearchService\nRecommendationService\nModerationService] as APPLICATION
}

' ── DOMAIN LAYER ──────────────────────────────────────────────────────
package "Domain Layer  ★  (Pure Python — zero external imports)" <<Rectangle>> #FDEBD0 {
    component [Entities\n────────────────\nUser\nProduct · Category\nOrder · OrderItem\nReview · Payment\nCart · ChatSession] as ENTITIES

    component [Value Objects\n────────────────\nMoney(amount, currency=COP)\nEmail (self-validated)\nOrderStatus (enum)\nRiskScore (0.0 – 1.0)\nSentiment (enum)] as VALUE_OBJECTS

    component [Repository Interfaces\n(Output Ports)\n────────────────\nIUserRepo\nIProductRepo\nIOrderRepo\nIPaymentGateway\nIAIService\nIVectorRepository] as INTERFACES
}

' ── INFRASTRUCTURE LAYER ──────────────────────────────────────────────
package "Infrastructure Layer" <<Rectangle>> #E8DAEF {
    component [Repository Implementations\n────────────────\nUserRepository (SQLAlchemy)\nProductRepository (SQLAlchemy)\nOrderRepository (SQLAlchemy)\nVectorRepository (pgvector)] as REPOS

    component [External Adapters\n────────────────\nGeminiAdapter (IAIService)\nWompiAdapter (IPaymentGateway)\nRedisCache\nSupabaseStorage] as ADAPTERS
}

' ── EXTERNAL SYSTEMS ──────────────────────────────────────────────────
package "External Systems" <<Rectangle>> #F2F3F4 {
    database "PostgreSQL 15\n+ pgvector\n(Supabase)" as PG
    database "Redis Cloud\n(NoSQL cache)" as REDIS
    component [Google Gemini\nFlash API] as GEMINI
    component [Wompi Colombia\n(Payments)] as WOMPI
}

' ── DEPENDENCY RULE (arrows always point INWARD) ──────────────────────
PRESENTATION -down-> APPLICATION : calls
SCHEMAS      -down-> APPLICATION : carries data to

APPLICATION  -down-> ENTITIES       : uses entities
APPLICATION  -down-> VALUE_OBJECTS  : uses value objects
APPLICATION  -down-> INTERFACES     : depends on (abstractions)

REPOS    -up-> INTERFACES : implements
ADAPTERS -up-> INTERFACES : implements

REPOS    -down-> PG    : SQL queries (TLS)
ADAPTERS -down-> REDIS  : key-value cache
ADAPTERS -down-> GEMINI : chat / embed / moderate
ADAPTERS -down-> WOMPI  : payments / webhooks

' ── DEPENDENCY INVERSION NOTE ─────────────────────────────────────────
note bottom of INTERFACES
  **Dependency Inversion Principle**
  The Domain defines INTERFACES.
  The Infrastructure IMPLEMENTS them.
  The Domain never imports from Infrastructure.
end note

note bottom of ENTITIES
  **No external imports.**
  Pure Python only.
  Fully unit-testable
  without any DB or framework.
end note

legend right
  | Layer            | Responsibility                          |
  | Presentation     | HTTP in/out, schema validation          |
  | Application      | Orchestrates use cases                  |
  | Domain ★         | Business rules — framework-agnostic     |
  | Infrastructure   | Implements ports, talks to externals    |
  Dependency Rule: arrows always point **inward** toward Domain.
endlegend

@enduml
