    {
      "name": "05 — Contrato Async (referencia)",
      "item": [
        {
          "name": "ORDER_CREATED — shape esperado del evento",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id",   "value": "{{customerId}}" },
              { "key": "X-User-Role", "value": "CUSTOMER" }
            ],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders","{{orderId}}"] },
            "description": "Este request NO prueba el broker directamente.\nDocumenta el shape del evento ORDER_CREATED que debe llegar al broker\ntras un POST /orders exitoso.\n\nShape esperado (RabbitMQ / JSON):\n{\n  \"eventType\": \"ORDER_CREATED\",\n  \"orderId\": \"5001\",\n  \"customerId\": \"101\",\n  \"restaurantId\": \"10\",\n  \"timestamp\": \"2026-04-06T21:10:00Z\",\n  \"payload\": {\n    \"status\": \"CREATED\",\n    \"totalAmount\": 74000\n  }\n}\n\nNotar: orderId, customerId, restaurantId son strings en el evento (contrato async).\ntotalAmount es número en el payload."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Este request verifica GET /orders/{id} como proxy de que el pedido fue creado.",
                  "// La validación del evento async requiere acceso directo al broker (RabbitMQ Management UI).",
                  "pm.test('Pedido existe (proxy de ORDER_CREATED)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status == CREATED (evento sería ORDER_CREATED)', () => pm.expect(body.status).to.eql('CREATED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 — Contract Shape Invariants",
      "item": [
        {
          "name": "Error shape invariant — ningún error devuelve HTML",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id",   "value": "{{customerId}}" },
              { "key": "X-User-Role", "value": "CUSTOMER" }
            ],
            "url": { "raw": "{{baseUrl}}/orders/999999", "host": ["{{baseUrl}}"], "path": ["orders","999999"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Content-Type es application/json', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('body parseable como JSON', () => {",
                  "    pm.expect(() => pm.response.json()).to.not.throw();",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('error tiene exactamente code y message', () => {",
                  "    pm.expect(Object.keys(body).sort()).to.eql(['code','message'].sort());",
                  "});",
                  "pm.test('code es string', () => pm.expect(body.code).to.be.a('string'));",
                  "pm.test('message es string', () => pm.expect(body.message).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "OrderStatus — valores válidos del sistema",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id",   "value": "{{customerId}}" },
              { "key": "X-User-Role", "value": "CUSTOMER" }
            ],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders","{{orderId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const validStatuses = ['CREATED','IN_PREPARATION','READY','DELIVERED','CANCELLED'];",
                  "pm.test('status es un valor válido del enum OrderStatus', () => {",
                  "    pm.expect(validStatuses).to.include(body.status);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
